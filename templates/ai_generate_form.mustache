{{!
    @template mod_playerpuzzle/ai_generate_form

    Topic/count form shown inside the "Generate with AI" modal. The Generate button and
    the results/status regions below are wired by amd/src/ai_generate.js, not by this
    template itself.

    Example context (json):
    {
        "topiclabel": "Topic",
        "countlabel": "How many questions",
        "generatelabel": "Generate",
        "counts": [
            {"value": 1, "selected": false},
            {"value": 5, "selected": true}
        ]
    }
}}
<div class="pp-ai-generate-form">
    <div class="mb-3">
        <label for="pp-ai-topic" class="form-label">{{topiclabel}}</label>
        <input type="text" id="pp-ai-topic" class="form-control" data-region="topic">
    </div>
    <div class="mb-3">
        <label for="pp-ai-count" class="form-label">{{countlabel}}</label>
        <select id="pp-ai-count" class="form-select" data-region="count">
            {{#counts}}
            <option value="{{value}}" {{#selected}}selected{{/selected}}>{{value}}</option>
            {{/counts}}
        </select>
    </div>
    <button type="button" class="btn btn-primary" data-action="pp-ai-run-generate">{{generatelabel}}</button>
    <div class="pp-ai-generate-status mt-2" data-region="status" aria-live="polite"></div>
    <div class="pp-ai-generate-results mt-3" data-region="results"></div>
</div>
