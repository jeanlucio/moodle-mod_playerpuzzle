{{!
    @template mod_playerpuzzle/campaignend_lines

    The lines that say how a Campaign went, shown on the end screen of its last match.

    Context variables required for this template:
    * lines - The lines, each with its text

    Example context (json):
    {
        "lines": [
            {"text": "The attempts of this Campaign are used up."},
            {"text": "You won 12 of 20 phases."},
            {"text": "Grade: 60.00 out of 100.00"},
            {"text": "Class ranking: position 3, with 60.0 points."}
        ]
    }
}}
<ul class="list-unstyled mb-0">
    {{#lines}}
    <li>{{text}}</li>
    {{/lines}}
</ul>
