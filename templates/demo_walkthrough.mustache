{{!
    @template mod_playerpuzzle/demo_walkthrough

    Static step-by-step walkthrough shown before a Demo match starts,
    rendered client-side into a native dialog by ui.js::showDemoWalkthrough(). Explains the
    HP bars and the buttons along the top (Give up, Opponent info, Music, Sound effects, Full screen), each with
    its own icon (the full screen one is drawn as the stage draws it, four corner marks), before combat input is
    enabled. Every
    step is rendered up front; ui.js toggles which one is visible and swaps the Next
    button's label on the last step.

    Example context (json):
    {
        "title": "How to Play",
        "nextlabel": "Next",
        "startlabel": "Start!",
        "steps": [
            {"title": "Welcome to the Demo!", "text": "Match 3 or more of the same piece...", "index": 0, "icon": "", "fullscreenicon": false},
            {"title": "Music Button", "text": "This button turns the background music on or off at any time.", "index": 1, "icon": "fa-volume-up", "fullscreenicon": false}
        ]
    }
}}
<dialog id="pp-demo-walkthrough-dialog" class="pp-demo-walkthrough pp-themed">
    <h2 class="h4 mb-2">{{title}}</h2>

    {{#steps}}
    <div class="pp-demo-walkthrough-step" data-step="{{index}}">
        <h3 class="h5">
            {{#icon}}<span class="pp-demo-walkthrough-icon" aria-hidden="true"><i class="fa {{icon}}"></i></span>{{/icon}}
            {{#fullscreenicon}}
            <span class="pp-demo-walkthrough-icon" aria-hidden="true">
                <svg viewBox="-1 -1 2 2" focusable="false">
                    <path d="M-0.723 -0.438H-0.438V-0.723M0.723 -0.438H0.438V-0.723M-0.723 0.438H-0.438V0.723M0.723 0.438H0.438V0.723"/>
                </svg>
            </span>
            {{/fullscreenicon}}
            {{title}}
        </h3>
        <p>{{text}}</p>
    </div>
    {{/steps}}

    <div class="pp-demo-walkthrough-footer mt-3 d-flex justify-content-between align-items-center">
        <span id="pp-demo-walkthrough-progress" class="text-muted small"></span>
        <button type="button" id="pp-demo-walkthrough-next" class="btn btn-primary" data-nextlabel="{{nextlabel}}" data-startlabel="{{startlabel}}">{{nextlabel}}</button>
    </div>
</dialog>
