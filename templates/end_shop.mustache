{{!
    @template mod_playerpuzzle/end_shop

    The shop on an end screen, hidden until the student goes on to the next match: the same shop as the Lobby's,
    before the next phase (a phase won) or the next try or match (Play again), so whatever is bought is in it.
    The shop itself is loaded into it when it opens.

    Example context (json):
    {
        "shoptitle": "Get ready for the next phase",
        "btnstart": "Start the next phase",
        "btnexitgame": "Exit game"
    }
}}
<div id="pp-end-shop" class="pp-phase-shop" hidden>
    <h2 class="pp-phase-shop-title">{{shoptitle}}</h2>
    <p id="pp-end-hero-evolved" class="pp-hero-evolved" role="status" hidden></p>
    <div id="pp-end-shop-body"></div>
    <div class="pp-gameover-buttons">
        <button id="btn-pp-start-next" class="btn btn-primary btn-lg shadow">
            {{btnstart}}
        </button>
        <button id="btn-pp-exit-shop" class="btn btn-secondary btn-lg shadow">
            {{btnexitgame}}
        </button>
    </div>
</div>
