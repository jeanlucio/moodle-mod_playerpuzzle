{{!
    @template mod_playerpuzzle/game_layout

    The game page: the game's box, with what goes in it for the match, and the live region the game speaks through.

    Context variables required for this template:
    * gameconfig - The game's config, as JSON
    * parts - What goes in the game's box, with the variables of mod_playerpuzzle/game_parts

    Example context (json):
    {
        "gameconfig": "{}",
        "parts": {
            "loadingtext": "Loading the game engine...",
            "giveup": {
                "title": "Give up the match?",
                "text": "This counts as a defeat.",
                "confirmlabel": "Give up",
                "cancellabel": "Keep playing"
            }
        }
    }
}}
<div class="playerpuzzle-game-wrapper d-flex flex-column align-items-center mt-3 mb-5">
    <div id="playerpuzzle-canvas-container" class="pp-canvas-container"
         aria-label="{{#str}} pluginname, mod_playerpuzzle {{/str}}" role="region"
         data-config="{{gameconfig}}">
        {{#parts}}
        {{> mod_playerpuzzle/game_parts }}
        {{/parts}}
    </div>
    <div id="pp-aria-live" class="visually-hidden" aria-live="polite" role="status"></div>
</div>
