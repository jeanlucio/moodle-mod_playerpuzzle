{{!
    @template mod_playerpuzzle/gameover_overlay

    Game over overlay rendered client-side inside the canvas container via core/templates.

    Example context (json):
    {
        "colorclass": "text-success",
        "msg": "Victory!",
        "coinscollected": "Coins collected:",
        "playergold": 150,
        "maxmultiplier": "Max multiplier:",
        "playermultiplier": "2.5",
        "savingprogress": "Saving progress...",
        "btnreview": "Review questions",
        "btnplayagain": "Play Again",
        "btnexitgame": "Exit Game",
        "difficultylabel": "Difficulty for the next try",
        "difficultychoices": [
            {"value": "easy", "label": "Easy", "checked": false},
            {"value": "normal", "label": "Normal", "checked": true},
            {"value": "hard", "label": "Hard", "checked": false}
        ],
        "unseentitle": "These items did not show up in this practice:",
        "unseen": [{"text": "Coin: earns coins to spend in the shop."}]
    }
}}
<div id="playerpuzzle-gameover" class="d-flex flex-column justify-content-center align-items-center">
    <div class="pp-gameover-card pp-themed d-flex flex-column align-items-center">
        <h1 class="display-4 pp-bold {{colorclass}} mb-3">{{msg}}</h1>
        <p class="lead mb-4">
            {{coinscollected}} <strong class="pp-accent">{{playergold}}</strong><br>
            {{maxmultiplier}} <strong class="pp-accent">x{{playermultiplier}}</strong>
        </p>
        {{#unseentitle}}
        <div class="pp-gameover-unseen small">
            <p class="mb-1">{{unseentitle}}</p>
            <ul class="mb-2">
                {{#unseen}}
                <li>{{text}}</li>
                {{/unseen}}
            </ul>
        </div>
        {{/unseentitle}}
        {{#difficultylabel}}
        <div class="mb-3 text-center">
            <label class="d-block mb-1" for="pp-retry-difficulty">{{difficultylabel}}</label>
            <select class="form-control d-inline-block w-auto" id="pp-retry-difficulty" disabled>
                {{#difficultychoices}}
                <option value="{{value}}" {{#checked}}selected{{/checked}}>{{label}}</option>
                {{/difficultychoices}}
            </select>
        </div>
        {{/difficultylabel}}
        <p id="pp-save-status" class="text-light small">{{savingprogress}}</p>
        <div class="pp-gameover-buttons">
            <button id="btn-pp-review" hidden class="btn btn-outline-light btn-lg shadow">
                {{btnreview}}
            </button>
            <button id="btn-pp-restart" disabled class="btn btn-primary btn-lg shadow">
                {{btnplayagain}}
            </button>
            <button id="btn-pp-exit" disabled class="btn btn-secondary btn-lg shadow">
                {{btnexitgame}}
            </button>
        </div>
    </div>
</div>
