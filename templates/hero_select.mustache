{{!
    @template mod_playerpuzzle/hero_select

    The screen where a student picks a hero.

    Context variables required for this template:
    * formurl - Where the form posts to
    * sesskey - The session key
    * fields - Hidden fields to send on, each with name and value
    * title - The heading
    * intro - What the choice means
    * error - A message above the heroes, empty when there is none
    * legend - The fieldset's legend
    * heroes - Each hero, with key, name, specialty, imageurl and checked
    * submitlabel - The button's text
    * backurl - Where Back goes, empty when there is nowhere to go back to
    * backlabel - Back's text

    Example context (json):
    {
        "formurl": "/mod/playerpuzzle/hero.php?id=1",
        "sesskey": "abc123example",
        "fields": [{"name": "mode", "value": "campaign"}],
        "title": "Choose your hero",
        "intro": "Your hero stays with you for the whole Campaign.",
        "error": "",
        "legend": "Choose your hero",
        "heroes": [
            {
                "key": "magef",
                "name": "Female mage",
                "specialty": "Specialty: HP",
                "imageurl": "/mod/playerpuzzle/pix/heroes/magef1.webp",
                "checked": false
            }
        ],
        "submitlabel": "Choose this hero",
        "backurl": "/mod/playerpuzzle/view.php?id=1",
        "backlabel": "Back to the Lobby"
    }
}}
<div class="pp-hero-page">
    <h2 class="pp-hero-title">{{title}}</h2>
    <p class="pp-hero-intro">{{intro}}</p>
    {{#error}}
    <div class="alert alert-danger" role="alert">{{error}}</div>
    {{/error}}
    <form method="post" action="{{formurl}}" class="pp-hero-form">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        {{#fields}}
        <input type="hidden" name="{{name}}" value="{{value}}">
        {{/fields}}
        <fieldset class="pp-hero-choices">
            <legend class="visually-hidden">{{legend}}</legend>
            {{#heroes}}
            <div class="pp-hero-card">
                <input type="radio" class="pp-hero-radio" name="hero" id="pp-hero-{{key}}" value="{{key}}" required {{#checked}}checked{{/checked}}>
                <label class="pp-hero-label" for="pp-hero-{{key}}">
                    <img class="pp-hero-image" src="{{imageurl}}" alt="" width="120" height="120">
                    <span class="pp-hero-name">{{name}}</span>
                    <span class="pp-hero-specialty">{{specialty}}</span>
                </label>
            </div>
            {{/heroes}}
        </fieldset>
        <div class="pp-hero-actions">
            <button type="submit" class="btn btn-primary">{{submitlabel}}</button>
            {{#backurl}}
            <a class="btn btn-secondary" href="{{backurl}}">{{backlabel}}</a>
            {{/backurl}}
        </div>
    </form>
</div>
