{{!
    @template mod_playerpuzzle/instance_list

    The PlayerPuzzle activities of a course, with a link to each.

    Example context (json):
    {
        "hasinstances": true,
        "emptytext": "There are no PlayerPuzzles",
        "instances": [
            {
                "name": "Dungeon Quiz",
                "url": "https://example.com/mod/playerpuzzle/view.php?id=1",
                "section": "Topic 1",
                "dimmed": false
            },
            {
                "name": "Boss Rush",
                "url": "https://example.com/mod/playerpuzzle/view.php?id=2",
                "section": "Topic 2",
                "dimmed": true
            }
        ]
    }
}}
{{#hasinstances}}
<table class="generaltable table table-striped">
    <thead>
        <tr>
            <th scope="col">{{#str}} section {{/str}}</th>
            <th scope="col">{{#str}} name {{/str}}</th>
        </tr>
    </thead>
    <tbody>
        {{#instances}}
        <tr>
            <td>{{section}}</td>
            <td><a href="{{url}}"{{#dimmed}} class="dimmed"{{/dimmed}}>{{name}}</a></td>
        </tr>
        {{/instances}}
    </tbody>
</table>
{{/hasinstances}}
{{^hasinstances}}
<p class="alert alert-info">{{emptytext}}</p>
{{/hasinstances}}
