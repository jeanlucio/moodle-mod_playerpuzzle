{{!
    @template mod_playerpuzzle/managequestions

    Question bank management listing for a PlayerPuzzle activity.

    Example context (json):
    {
        "cmid": 2,
        "sesskey": "abc123",
        "addurl": "https://example.com/mod/playerpuzzle/managequestions.php?id=2&action=add",
        "addquestionlabel": "Add question",
        "aiavailable": true,
        "generatewithailabel": "Generate with AI",
        "importheader": "Import from the question bank",
        "importtogglelabel": "Import from the question bank",
        "importhtml": "<form><label for=\"id_categoryid\">Category</label><select id=\"id_categoryid\"><option>Cat (2 questions)</option></select></form>",
        "hasquestions": true,
        "hasrows": true,
        "noquestionslabel": "No questions have been added yet.",
        "nomatchlabel": "No questions match these filters.",
        "filteraction": "https://example.com/mod/playerpuzzle/managequestions.php",
        "filterlabel": "Filter and sort the questions",
        "filterbutton": "Apply",
        "phasefilterlabel": "Phase",
        "phasefilteroptions": [
            {"value": "", "label": "All phases", "selected": true},
            {"value": "none", "label": "No phase set", "selected": false},
            {"value": "1", "label": "Phase 1", "selected": false}
        ],
        "statusfilterlabel": "Status",
        "statusfilteroptions": [
            {"value": "", "label": "All", "selected": true},
            {"value": "approved", "label": "Approved", "selected": false}
        ],
        "sortbylabel": "Sort by",
        "sortoptions": [
            {"value": "id", "label": "Most recent", "selected": true},
            {"value": "phase", "label": "Phase", "selected": false}
        ],
        "sortdirlabel": "Order",
        "sortdiroptions": [
            {"value": "ASC", "label": "Ascending", "selected": false},
            {"value": "DESC", "label": "Descending", "selected": true}
        ],
        "showingcount": "Showing 1 of 1",
        "filtersactive": true,
        "clearfiltersurl": "https://example.com/mod/playerpuzzle/managequestions.php?id=2",
        "clearfilterslabel": "Clear filters",
        "questioncolumnlabel": "Question",
        "phasecolumnlabel": "Phase",
        "statuscolumnlabel": "Status",
        "drawcountcolumnlabel": "Times drawn",
        "actionscolumnlabel": "Actions",
        "sort_phase_url": "https://example.com/mod/playerpuzzle/managequestions.php?id=2&sort=phase&dir=ASC",
        "sort_phase_icon": "fa-sort",
        "sort_phase_aria": "none",
        "sort_status_url": "https://example.com/mod/playerpuzzle/managequestions.php?id=2&sort=status&dir=ASC",
        "sort_status_icon": "fa-sort",
        "sort_status_aria": "none",
        "sort_drawn_url": "https://example.com/mod/playerpuzzle/managequestions.php?id=2&sort=drawn&dir=ASC",
        "sort_drawn_icon": "fa-sort",
        "sort_drawn_aria": "none",
        "selectalllabel": "Select all questions",
        "selectquestionlabel": "Select question",
        "bulkhidden": [{"name": "id", "value": "2"}],
        "bulkhint": "Select questions to approve them, set their phase or delete them.",
        "bulkselectedone": "1 selected",
        "bulkselectedmany": "{$a} selected",
        "bulkclearbutton": "Clear selection",
        "bulkapprovebutton": "Approve",
        "bulkapprovebuttontitle": "Approve selected questions",
        "bulkapproveconfirm": "Are you sure you want to approve the selected questions?",
        "bulkphaseselectlabel": "Phase to set on the selected questions",
        "bulkphaseoptions": [
            {"value": 0, "label": "Any phase"},
            {"value": 1, "label": "Phase 1"}
        ],
        "bulkphasebutton": "Set phase",
        "bulkdeletebutton": "Delete",
        "bulkdeleteconfirm": "Are you sure you want to delete the selected questions?",
        "deletequestionbutton": "Delete",
        "deletequestiontitle": "Delete question",
        "deletequestionconfirm": "Are you sure you want to delete this question?",
        "editquestionbutton": "Edit",
        "questions": [
            {
                "id": 5,
                "questiontext": "What is 2 + 2?",
                "answerspreview": "✓ 4 · 3 · 5",
                "metaline": "Multiple choice · Manual",
                "phaselabel": "Phase 3",
                "hasphase": true,
                "statuslabel": "Pending approval",
                "statusbadgeclass": "bg-warning text-dark",
                "canapprove": true,
                "approveurl": "https://example.com/mod/playerpuzzle/managequestions.php?id=2&action=approve&qid=5",
                "approvelabel": "Approve",
                "editurl": "https://example.com/mod/playerpuzzle/managequestions.php?id=2&action=edit&qid=5",
                "drawcount": 3
            }
        ],
        "pagingbar": "<nav aria-label=\"pagination\">…</nav>",
        "backurl": "https://example.com/mod/playerpuzzle/view.php?id=2",
        "backlabel": "Back"
