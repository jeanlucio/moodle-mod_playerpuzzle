}}
<div class="pp-actionbar">
    <a href="{{addurl}}" class="btn btn-primary">{{addquestionlabel}}</a>
    {{#aiavailable}}
    <button type="button" class="btn btn-outline-primary" data-action="pp-ai-generate" data-cmid="{{cmid}}">
        {{generatewithailabel}}
    </button>
    {{/aiavailable}}
    <button type="button"
            id="pp-import-toggle"
            class="btn btn-outline-secondary"
            aria-expanded="true"
            aria-controls="pp-import-panel"
            hidden>
        {{importtogglelabel}}
    </button>
</div>

<div id="pp-import-panel" class="pp-import-panel">
    <h3 class="h5">{{importheader}}</h3>
    {{{importhtml}}}
</div>

{{^hasquestions}}
<div class="alert alert-info" role="alert">{{noquestionslabel}}</div>
{{/hasquestions}}

{{#hasquestions}}
<form id="pp-filter-form" class="pp-filters" method="get" action="{{{filteraction}}}" aria-label="{{filterlabel}}">
    <input type="hidden" name="id" value="{{cmid}}">
    <div class="pp-filter-group">
        <label for="pp-filter-phase">{{phasefilterlabel}}</label>
        <select id="pp-filter-phase" name="phase" class="form-select form-select-sm custom-select custom-select-sm">
            {{#phasefilteroptions}}
            <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
            {{/phasefilteroptions}}
        </select>
    </div>
    <div class="pp-filter-group">
        <label for="pp-filter-status">{{statusfilterlabel}}</label>
        <select id="pp-filter-status" name="status" class="form-select form-select-sm custom-select custom-select-sm">
            {{#statusfilteroptions}}
            <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
            {{/statusfilteroptions}}
        </select>
    </div>
    <div class="pp-filter-group">
        <label for="pp-filter-sort">{{sortbylabel}}</label>
        <span class="pp-ig">
            <select id="pp-filter-sort" name="sort" class="form-select form-select-sm custom-select custom-select-sm">
                {{#sortoptions}}
                <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                {{/sortoptions}}
            </select>
            <select id="pp-filter-dir" name="dir" class="form-select form-select-sm custom-select custom-select-sm" aria-label="{{sortdirlabel}}">
                {{#sortdiroptions}}
                <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                {{/sortdiroptions}}
            </select>
        </span>
    </div>
    <button type="submit" id="pp-filter-apply" class="btn btn-outline-secondary btn-sm">{{filterbutton}}</button>
    {{#filtersactive}}
    <a href="{{{clearfiltersurl}}}" class="pp-filter-clear">{{clearfilterslabel}}</a>
    {{/filtersactive}}
    <span class="pp-filter-count" role="status">{{showingcount}}</span>
</form>

<form id="playerpuzzle-bulk-form" method="post" action="{{{config.wwwroot}}}/mod/playerpuzzle/managequestions.php">
    {{#bulkhidden}}
    <input type="hidden" name="{{name}}" value="{{value}}">
    {{/bulkhidden}}
    <input type="hidden" id="playerpuzzle-bulk-action" name="bulkaction" value="">
    <input type="hidden" name="sesskey" value="{{sesskey}}">

    <div class="pp-bulkbar" id="pp-bulkbar"
         data-one="{{bulkselectedone}}"
         data-many="{{bulkselectedmany}}">
        <span class="pp-bulkbar-hint" id="pp-bulk-hint">{{bulkhint}}</span>
        <div class="pp-bulkbar-actions" id="pp-bulk-actions">
            <strong class="pp-bulk-count" id="pp-bulk-count" role="status"></strong>
            <button type="button"
                    id="playerpuzzle-bulk-approve-btn"
                    class="btn btn-outline-success btn-sm"
                    data-labelbase="{{bulkapprovebutton}}"
                    data-title="{{bulkapprovebuttontitle}}"
                    data-confirm="{{bulkapproveconfirm}}"
                    disabled>
                {{bulkapprovebutton}}
            </button>
            <span class="pp-ig">
                <label for="playerpuzzle-bulk-phase" class="visually-hidden">{{bulkphaseselectlabel}}</label>
                <select id="playerpuzzle-bulk-phase" name="bulkphase" class="form-select form-select-sm custom-select custom-select-sm">
                    {{#bulkphaseoptions}}
                    <option value="{{value}}">{{label}}</option>
                    {{/bulkphaseoptions}}
                </select>
                <button type="button" id="playerpuzzle-bulk-phase-btn" class="btn btn-outline-secondary btn-sm">
                    {{bulkphasebutton}}
                </button>
            </span>
            <button type="button"
                    id="playerpuzzle-bulk-delete-btn"
                    class="btn btn-outline-danger btn-sm"
                    data-labelbase="{{bulkdeletebutton}}"
                    data-title="{{deletequestiontitle}}"
                    data-confirm="{{bulkdeleteconfirm}}"
                    disabled>
                {{bulkdeletebutton}}
            </button>
            <button type="button" id="pp-bulk-clear" class="btn btn-link btn-sm">{{bulkclearbutton}}</button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="generaltable pp-questions">
            <thead>
                <tr>
                    <th scope="col">
                        <input type="checkbox"
                               id="playerpuzzle-select-all"
                               class="form-check-input"
                               aria-label="{{selectalllabel}}">
                    </th>
                    <th scope="col">{{questioncolumnlabel}}</th>
                    <th scope="col" aria-sort="{{sort_phase_aria}}">
                        <a href="{{{sort_phase_url}}}" class="text-reset text-decoration-none">
                            {{phasecolumnlabel}}
                            <i class="fa {{sort_phase_icon}}" aria-hidden="true"></i>
                        </a>
                    </th>
                    <th scope="col" aria-sort="{{sort_status_aria}}">
                        <a href="{{{sort_status_url}}}" class="text-reset text-decoration-none">
                            {{statuscolumnlabel}}
                            <i class="fa {{sort_status_icon}}" aria-hidden="true"></i>
                        </a>
                    </th>
                    <th scope="col" aria-sort="{{sort_drawn_aria}}">
                        <a href="{{{sort_drawn_url}}}" class="text-reset text-decoration-none">
                            {{drawcountcolumnlabel}}
                            <i class="fa {{sort_drawn_icon}}" aria-hidden="true"></i>
                        </a>
                    </th>
                    <th scope="col">{{actionscolumnlabel}}</th>
                </tr>
            </thead>
            <tbody>
                {{^hasrows}}
                <tr>
                    <td colspan="6" class="text-center">
                        {{nomatchlabel}}
                        <a href="{{{clearfiltersurl}}}">{{clearfilterslabel}}</a>
                    </td>
                </tr>
                {{/hasrows}}
                {{#questions}}
                <tr>
                    <td>
                        <input type="checkbox"
                               name="bulk_ids[]"
                               value="{{id}}"
                               class="form-check-input playerpuzzle-bulk-check"
                               aria-label="{{selectquestionlabel}} {{questiontext}}"
                               {{#canapprove}}data-approvable="1"{{/canapprove}}>
                    </td>
                    <td class="pp-question-cell">
                        <div class="pp-question-text">{{questiontext}}</div>
                        <div class="pp-question-answers">{{answerspreview}}</div>
                        <div class="pp-question-meta">{{metaline}}</div>
                    </td>
                    <td class="text-nowrap">
                        {{#hasphase}}<span class="pp-phase-pill">{{phaselabel}}</span>{{/hasphase}}
                        {{^hasphase}}<span class="pp-phase-any">{{phaselabel}}</span>{{/hasphase}}
                    </td>
                    <td class="text-nowrap">
                        <span class="badge {{statusbadgeclass}}">{{statuslabel}}</span>
                    </td>
                    <td>{{drawcount}}</td>
                    <td>
                        <div class="pp-row-actions">
                            <a href="{{{editurl}}}" class="btn btn-outline-secondary btn-sm">
                                {{editquestionbutton}}
                            </a>
                            {{#canapprove}}
                            <a href="{{{approveurl}}}" class="btn btn-outline-success btn-sm">
                                {{approvelabel}}
                            </a>
                            {{/canapprove}}
                            <button type="button"
                                    class="btn btn-outline-danger btn-sm playerpuzzle-single-delete-btn"
                                    data-questionid="{{id}}"
                                    data-title="{{deletequestiontitle}}"
                                    data-confirm="{{deletequestionconfirm}}">
                                {{deletequestionbutton}}
                            </button>
                        </div>
                    </td>
                </tr>
                {{/questions}}
            </tbody>
        </table>
    </div>
    {{{pagingbar}}}
</form>
{{/hasquestions}}

<a href="{{backurl}}" class="btn btn-secondary mt-3">{{backlabel}}</a>
