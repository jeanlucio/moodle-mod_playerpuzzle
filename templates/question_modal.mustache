{{!
    @template mod_playerpuzzle/question_modal

    The in-combat question challenge, as a native HTML <dialog> — chosen over a
    Bootstrap modal specifically for this element so focus trapping, ESC handling, and
    top-layer stacking are all handled natively by the browser instead of depending on
    Bootstrap's own modal JS. combat.js opens it with showModal() only once
    its content (question text, answer buttons) is already in the DOM, so the browser's
    own auto-focus lands on a real answer button, and saves/restores focus to whatever
    triggered it.

    Example context (json):
    {
    }
}}
<dialog id="playerpuzzle-modal" class="pp-question-modal" aria-labelledby="playerpuzzle-question-text">
    <div class="pp-question-modal-header">
        <h5 class="pp-question-modal-title">{{#str}} questionchallenge, mod_playerpuzzle {{/str}}</h5>
    </div>
    <div class="pp-question-modal-body">
        <h4 id="playerpuzzle-question-text">{{#str}} loading, mod_playerpuzzle {{/str}}</h4>
        <div id="playerpuzzle-answers-container" class="d-grid gap-2"></div>
    </div>
    <div class="pp-question-modal-footer d-flex justify-content-between">
        <button type="button" class="btn btn-outline-secondary" id="playerpuzzle-btn-skip">
            {{#str}} skip, mod_playerpuzzle {{/str}}
        </button>
        <button type="button" class="btn btn-secondary" id="playerpuzzle-btn-confirm">
            {{#str}} close, mod_playerpuzzle {{/str}}
        </button>
    </div>
</dialog>
