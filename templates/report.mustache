{{!
    @template mod_playerpuzzle/report

    Teacher report for the PlayerPuzzle activity: per-student progress, most missed
    questions, score distribution and completion rate.

    Example context (json):
    {
        "activityname": "Dungeon Quiz",
        "activityurl": "/mod/playerpuzzle/view.php?id=1",
        "backlabel": "Back to activity",
        "reporttitle": "Report",
        "studentrows": [
            {
                "userid": 2,
                "fullname": "Ana Souza",
                "hasgrade": true,
                "grade": "82.50",
                "attemptsused": 3,
                "avgdamagepercent": "76.4",
                "avgcorrect": "4.3",
                "avgtotal": "5.0",
                "lastmatch": "14 September 2026, 10:32 AM"
            }
        ],
        "studentrowsempty": false,
        "haspaging": true,
        "pagingbar": "<nav aria-label=\"Page\"><ul class=\"pagination\"><li class=\"page-item active\"><span class=\"page-link\">1</span></li></ul></nav>",
        "pagingsummary": "Showing 1–50 of 120 students",
        "missedquestions": [
            {"questiontext": "How much is 2 + 2?", "errors": 6, "total": 10, "errorrate": 60.0, "errorratetext": "60.0"}
        ],
        "missedquestionsempty": false,
        "activityhasgrade": true,
        "distribution": [
            {"min": 0, "max": 20, "count": 1, "barpercent": 20},
            {"min": 21, "max": 40, "count": 2, "barpercent": 40},
            {"min": 41, "max": 60, "count": 0, "barpercent": 0},
            {"min": 61, "max": 80, "count": 3, "barpercent": 60},
            {"min": 81, "max": 100, "count": 5, "barpercent": 100}
        ],
        "hasdifficulty": true,
        "difficulties": [
            {"name": "Normal", "students": 12, "fights": 80, "firsttry": "58% (30/52)", "tries": "1.5"}
        ],
        "phasecolumns": [{"name": "Normal"}],
        "hasmatches": false,
        "matches": [
            {"name": "Normal", "students": 12, "matches": 30, "won": "47% (14/30)"}
        ],
        "hasheroes": true,
        "heroes": [
            {"name": "Female warrior", "specialty": "Attack", "campaigns": 7, "students": 6, "firsttry": "61% (42/69)"}
        ],
        "phases": [
            {"phase": 1, "cells": [{"text": "90% (9/10)"}]}
        ],
        "completedcount": 5,
        "completedtotal": 10,
        "completedpercent": "50.0",
        "iscampaign": true
    }
}}
<div class="path-mod-playerpuzzle-report">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0">{{reporttitle}} — {{activityname}}</h3>
        <a href="{{activityurl}}" class="btn btn-secondary">{{backlabel}}</a>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h4>{{#str}} report_completionrate, mod_playerpuzzle {{/str}}</h4>
            <p class="mb-1">
                {{#iscampaign}}
                    {{#str}} report_completioncampaign_desc, mod_playerpuzzle {{/str}}
                {{/iscampaign}}
                {{^iscampaign}}
                    {{#str}} report_completionsingle_desc, mod_playerpuzzle {{/str}}
                {{/iscampaign}}
            </p>
            <p class="mb-0">
                <strong>{{completedcount}} / {{completedtotal}}</strong>
                ({{completedpercent}}%)
            </p>
        </div>
    </div>

    {{^activityhasgrade}}
    <div class="card mb-4">
        <div class="card-body">
            <h4>{{#str}} report_scoredistribution, mod_playerpuzzle {{/str}}</h4>
            <p class="mb-0">{{#str}} report_nograde, mod_playerpuzzle {{/str}}</p>
        </div>
    </div>
    {{/activityhasgrade}}
    {{#activityhasgrade}}
    <div class="card mb-4">
        <div class="card-body">
            <h4>{{#str}} report_scoredistribution, mod_playerpuzzle {{/str}}</h4>
            <p class="mb-3">{{#str}} report_scoredistribution_desc, mod_playerpuzzle {{/str}}</p>
            {{#distribution}}
                <div class="d-flex align-items-center mb-2">
                    <span class="pp-report-bucket-label me-2">{{min}}–{{max}}%</span>
                    <div class="progress flex-grow-1">
                        <div class="progress-bar" style="width: {{barpercent}}%">
                            <span class="visually-hidden">{{count}}</span>
                        </div>
                    </div>
                    <span class="ms-2" aria-hidden="true">{{count}}</span>
                </div>
            {{/distribution}}
        </div>
    </div>
    {{/activityhasgrade}}

    {{#hasdifficulty}}
    <div class="card mb-4">
        <div class="card-body">
            <h4>{{#str}} report_difficulty, mod_playerpuzzle {{/str}}</h4>
            <p class="mb-3">{{#str}} report_difficulty_desc, mod_playerpuzzle {{/str}}</p>
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th scope="col">{{#str}} report_difficultyname, mod_playerpuzzle {{/str}}</th>
                            <th scope="col">{{#str}} report_students, mod_playerpuzzle {{/str}}</th>
                            <th scope="col">{{#str}} report_phasesplayed, mod_playerpuzzle {{/str}}</th>
                            <th scope="col">{{#str}} report_firsttry, mod_playerpuzzle {{/str}}</th>
                            <th scope="col">{{#str}} report_triesperphase, mod_playerpuzzle {{/str}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#difficulties}}
                            <tr>
                                <th scope="row">{{name}}</th>
                                <td>{{students}}</td>
                                <td>{{fights}}</td>
                                <td>{{firsttry}}</td>
                                <td>{{tries}}</td>
                            </tr>
                        {{/difficulties}}
                    </tbody>
                </table>
            </div>
            <h5 class="mt-4">{{#str}} report_difficultybyphase, mod_playerpuzzle {{/str}}</h5>
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th scope="col">{{#str}} report_phase, mod_playerpuzzle {{/str}}</th>
                            {{#phasecolumns}}
                                <th scope="col">{{name}}</th>
                            {{/phasecolumns}}
                        </tr>
                    </thead>
                    <tbody>
                        {{#phases}}
                            <tr>
                                <th scope="row">{{phase}}</th>
                                {{#cells}}
                                    <td>{{text}}</td>
                                {{/cells}}
                            </tr>
                        {{/phases}}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    {{/hasdifficulty}}

    {{#hasmatches}}
    <div class="card mb-4">
        <div class="card-body">
            <h4>{{#str}} report_difficulty, mod_playerpuzzle {{/str}}</h4>
            <p class="mb-3">{{#str}} report_difficulty_single_desc, mod_playerpuzzle {{/str}}</p>
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th scope="col">{{#str}} report_difficultyname, mod_playerpuzzle {{/str}}</th>
                            <th scope="col">{{#str}} report_students, mod_playerpuzzle {{/str}}</th>
                            <th scope="col">{{#str}} report_matches, mod_playerpuzzle {{/str}}</th>
                            <th scope="col">{{#str}} report_matcheswon, mod_playerpuzzle {{/str}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#matches}}
                            <tr>
                                <th scope="row">{{name}}</th>
                                <td>{{students}}</td>
                                <td>{{matches}}</td>
                                <td>{{won}}</td>
                            </tr>
                        {{/matches}}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    {{/hasmatches}}

    {{#hasheroes}}
    <div class="card mb-4">
        <div class="card-body">
            <h4>{{#str}} report_heroes, mod_playerpuzzle {{/str}}</h4>
            <p class="mb-3">{{#str}} report_heroes_desc, mod_playerpuzzle {{/str}}</p>
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th scope="col">{{#str}} report_hero, mod_playerpuzzle {{/str}}</th>
                            <th scope="col">{{#str}} report_herospecialty, mod_playerpuzzle {{/str}}</th>
                            <th scope="col">{{#str}} report_campaigns, mod_playerpuzzle {{/str}}</th>
                            <th scope="col">{{#str}} report_students, mod_playerpuzzle {{/str}}</th>
                            <th scope="col">{{#str}} report_firsttry, mod_playerpuzzle {{/str}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#heroes}}
                            <tr>
                                <th scope="row">{{name}}</th>
                                <td>{{specialty}}</td>
                                <td>{{campaigns}}</td>
                                <td>{{students}}</td>
                                <td>{{firsttry}}</td>
                            </tr>
                        {{/heroes}}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    {{/hasheroes}}

    <div class="card mb-4">
        <div class="card-body">
            <h4>{{#str}} report_studenttable, mod_playerpuzzle {{/str}}</h4>
            {{#studentrowsempty}}
                <p>{{#str}} report_nostudents, mod_playerpuzzle {{/str}}</p>
            {{/studentrowsempty}}
            {{^studentrowsempty}}
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th scope="col">{{#str}} report_student, mod_playerpuzzle {{/str}}</th>
                                {{#activityhasgrade}}
                                <th scope="col">{{#str}} report_grade, mod_playerpuzzle {{/str}}</th>
                                {{/activityhasgrade}}
                                <th scope="col">{{#str}} report_attempts, mod_playerpuzzle {{/str}}</th>
                                <th scope="col">{{#str}} report_avgdamage, mod_playerpuzzle {{/str}}</th>
                                <th scope="col">{{#str}} report_avgquestions, mod_playerpuzzle {{/str}}</th>
                                <th scope="col">{{#str}} report_lastmatch, mod_playerpuzzle {{/str}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#studentrows}}
                                <tr>
                                    <td>{{fullname}}</td>
                                    {{#activityhasgrade}}
                                    <td>{{grade}}</td>
                                    {{/activityhasgrade}}
                                    <td>{{attemptsused}}</td>
                                    <td>{{avgdamagepercent}}%</td>
                                    <td>{{avgcorrect}} / {{avgtotal}}</td>
                                    <td>{{lastmatch}}</td>
                                </tr>
                            {{/studentrows}}
                        </tbody>
                    </table>
                </div>
                {{#haspaging}}
                    <p class="mb-2" role="status">{{pagingsummary}}</p>
                    {{{pagingbar}}}
                {{/haspaging}}
            {{/studentrowsempty}}
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h4>{{#str}} report_missedquestions, mod_playerpuzzle {{/str}}</h4>
            {{#missedquestionsempty}}
                <p>{{#str}} report_nomissedquestions, mod_playerpuzzle {{/str}}</p>
            {{/missedquestionsempty}}
            {{^missedquestionsempty}}
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th scope="col">{{#str}} report_question, mod_playerpuzzle {{/str}}</th>
                                <th scope="col">{{#str}} report_errorrate, mod_playerpuzzle {{/str}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#missedquestions}}
                                <tr>
                                    <td>{{questiontext}}</td>
                                    <td>{{errorratetext}}% ({{errors}}/{{total}})</td>
                                </tr>
                            {{/missedquestions}}
                        </tbody>
                    </table>
                </div>
            {{/missedquestionsempty}}
        </div>
    </div>
</div>
