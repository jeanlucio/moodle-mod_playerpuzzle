{{!
    @template mod_playerpuzzle/report

    Teacher report for the PlayerPuzzle activity: per-student progress, most missed
    questions, score distribution and completion rate.

    Example context (json):
    {
        "activityname": "Dungeon Quiz",
        "activityurl": "/mod/playerpuzzle/view.php?id=1",
        "backlabel": "Back to activity",
        "reporttitle": "Report",
        "studentrows": [
            {
                "userid": 2,
                "fullname": "Ana Souza",
                "hasgrade": true,
                "grade": "82.50",
                "attemptsused": 3,
                "avgdamagepercent": "76.4",
                "avgcorrect": "4.3",
                "avgtotal": "5.0",
                "lastmatch": "14 September 2026, 10:32 AM"
            }
        ],
        "studentrowsempty": false,
        "missedquestions": [
            {"questiontext": "How much is 2 + 2?", "errors": 6, "total": 10, "errorrate": 60.0}
        ],
        "missedquestionsempty": false,
        "distribution": [
            {"min": 0, "max": 20, "count": 1, "barpercent": 20},
            {"min": 21, "max": 40, "count": 2, "barpercent": 40},
            {"min": 41, "max": 60, "count": 0, "barpercent": 0},
            {"min": 61, "max": 80, "count": 3, "barpercent": 60},
            {"min": 81, "max": 100, "count": 5, "barpercent": 100}
        ],
        "completedcount": 5,
        "completedtotal": 10,
        "completedpercent": 50.0,
        "iscampaign": true
    }
}}
<div class="path-mod-playerpuzzle-report">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0">{{reporttitle}} — {{activityname}}</h3>
        <a href="{{activityurl}}" class="btn btn-secondary">{{backlabel}}</a>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h4>{{#str}} report_completionrate, mod_playerpuzzle {{/str}}</h4>
            <p class="mb-1">
                {{#iscampaign}}
                    {{#str}} report_completioncampaign_desc, mod_playerpuzzle {{/str}}
                {{/iscampaign}}
                {{^iscampaign}}
                    {{#str}} report_completionsingle_desc, mod_playerpuzzle {{/str}}
                {{/iscampaign}}
            </p>
            <p class="mb-0">
                <strong>{{completedcount}} / {{completedtotal}}</strong>
                ({{completedpercent}}%)
            </p>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h4>{{#str}} report_scoredistribution, mod_playerpuzzle {{/str}}</h4>
            {{#distribution}}
                <div class="d-flex align-items-center mb-2">
                    <span class="pp-report-bucket-label me-2">{{min}}–{{max}}</span>
                    <div class="progress flex-grow-1">
                        <div class="progress-bar" style="width: {{barpercent}}%">
                            <span class="visually-hidden">{{count}}</span>
                        </div>
                    </div>
                    <span class="ms-2" aria-hidden="true">{{count}}</span>
                </div>
            {{/distribution}}
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h4>{{#str}} report_studenttable, mod_playerpuzzle {{/str}}</h4>
            {{#studentrowsempty}}
                <p>{{#str}} report_nostudents, mod_playerpuzzle {{/str}}</p>
            {{/studentrowsempty}}
            {{^studentrowsempty}}
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th scope="col">{{#str}} report_student, mod_playerpuzzle {{/str}}</th>
                                <th scope="col">{{#str}} report_grade, mod_playerpuzzle {{/str}}</th>
                                <th scope="col">{{#str}} report_attempts, mod_playerpuzzle {{/str}}</th>
                                <th scope="col">{{#str}} report_avgdamage, mod_playerpuzzle {{/str}}</th>
                                <th scope="col">{{#str}} report_avgquestions, mod_playerpuzzle {{/str}}</th>
                                <th scope="col">{{#str}} report_lastmatch, mod_playerpuzzle {{/str}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#studentrows}}
                                <tr>
                                    <td>{{fullname}}</td>
                                    <td>{{grade}}</td>
                                    <td>{{attemptsused}}</td>
                                    <td>{{avgdamagepercent}}%</td>
                                    <td>{{avgcorrect}} / {{avgtotal}}</td>
                                    <td>{{lastmatch}}</td>
                                </tr>
                            {{/studentrows}}
                        </tbody>
                    </table>
                </div>
            {{/studentrowsempty}}
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h4>{{#str}} report_missedquestions, mod_playerpuzzle {{/str}}</h4>
            {{#missedquestionsempty}}
                <p>{{#str}} report_nomissedquestions, mod_playerpuzzle {{/str}}</p>
            {{/missedquestionsempty}}
            {{^missedquestionsempty}}
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th scope="col">{{#str}} report_question, mod_playerpuzzle {{/str}}</th>
                                <th scope="col">{{#str}} report_errorrate, mod_playerpuzzle {{/str}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#missedquestions}}
                                <tr>
                                    <td>{{questiontext}}</td>
                                    <td>{{errorrate}}% ({{errors}}/{{total}})</td>
                                </tr>
                            {{/missedquestions}}
                        </tbody>
                    </table>
                </div>
            {{/missedquestionsempty}}
        </div>
    </div>
</div>
