{{!
    @template mod_playerpuzzle/shop_panel

    The shop, the same in the Lobby and on the screen between phases: the PuzzleCoin balance, the consumables
    and, in a Campaign with a hero, the hero's upgrades.

    Context variables required for this template:
    * cmid - The course module id
    * coinstext - The balance as read to a screen reader
    * coinvalue - The balance
    * shopitems - The consumables, each with type, icon, label, ownedtext, limittext, price, buylabel and arialabel
    * hasupgrades - Whether the hero's upgrades are shown, with the variables of mod_playerpuzzle/shop_upgrades
    * opponentcard - The opponent of the next phase, with the variables of mod_playerpuzzle/opponent_card
    * phasenote - A note when a phase is under way, empty otherwise

    Example context (json):
    {
        "cmid": 1,
        "coinstext": "PuzzleCoin: 40",
        "coinvalue": 40,
        "shopitems": [
            {
                "type": "potion",
                "icon": "fa-flask",
                "label": "Potion",
                "ownedtext": "Owned: 0",
                "limittext": "Up to 3 per phase",
                "price": 8,
                "buylabel": "Buy",
                "arialabel": "Buy Potion for 8 coins"
            }
        ],
        "hasupgrades": false
    }
}}
<div class="pp-shop-panel" data-cmid="{{cmid}}">
    <p class="pp-shop-error alert alert-danger" role="alert" hidden></p>
    <div class="pp-lobby-stats">
        <span class="pp-lobby-chip" data-role="coinchip" aria-label="{{coinstext}}">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="9" fill="#e0a83e" stroke="#8a611c" stroke-width="1.5"/>
                <circle cx="12" cy="12" r="5.4" fill="none" stroke="#8a611c" stroke-width="1.2"/>
            </svg>
            <span data-role="coinvalue" aria-hidden="true">{{coinvalue}}</span>
        </span>
    </div>
    {{#phasenote}}
    <p class="pp-shop-note" role="status"><i class="fa fa-circle-info" aria-hidden="true"></i>{{phasenote}}</p>
    {{/phasenote}}
    {{#opponentcard}}
    {{> mod_playerpuzzle/opponent_card }}
    {{/opponentcard}}
    {{#hasupgrades}}
    {{> mod_playerpuzzle/shop_upgrades }}
    {{/hasupgrades}}
    <div class="pp-lobby-shop" data-cmid="{{cmid}}">
        <ul class="pp-lobby-shop-list pp-shop-tiles">
            {{#shopitems}}
            <li class="pp-lobby-shop-item" data-type="{{type}}">
                <i class="fa {{icon}} pp-shop-tile-icon" aria-hidden="true"></i>
                <span class="pp-lobby-shop-name">{{label}}</span>
                <span class="pp-lobby-shop-owned" data-role="owned">{{ownedtext}}</span>
                <span class="pp-lobby-shop-limit">{{limittext}}</span>
                <button
                    type="button"
                    class="btn btn-sm btn-primary pp-lobby-buy"
                    data-type="{{type}}"
                    aria-label="{{arialabel}}"
                >
                    {{buylabel}}
                    <span class="pp-lobby-shop-price" aria-hidden="true">🪙{{price}}</span>
                </button>
            </li>
            {{/shopitems}}
        </ul>
    </div>
</div>
