{{!
    @template mod_playerpuzzle/view_lobby

    Lobby layout for the PlayerPuzzle activity.

    Example context (json):
    {
        "playurl": "/mod/playerpuzzle/play.php?id=1",
        "playtext": "Play Game",
        "sesskey": "abc123example",
        "readytext": "Ready for adventure?",
        "heroimageurl": "https://example.com/moodle/theme/image.php/boost/mod_playerpuzzle/1/player",
        "panelstoneurl": "https://example.com/moodle/mod/playerpuzzle/pix/panel_stone.webp",
        "scrollbannerurl": "https://example.com/moodle/mod/playerpuzzle/pix/scroll_banner.webp",
        "cmid": 1,
        "coinvalue": 42,
        "coinstext": "PuzzleCoin: 42",
        "shoptitle": "Loadout Shop",
        "shopitems": [
            {"type": "potion", "label": "Potion", "quantity": 2, "ownedtext": "Owned: 2", "price": 8, "buylabel": "Buy", "arialabel": "Buy Potion for 8 coins"},
            {"type": "shield", "label": "Shield", "quantity": 0, "ownedtext": "Owned: 0", "price": 10, "buylabel": "Buy", "arialabel": "Buy Shield for 10 coins"}
        ],
        "hastransfer": true,
        "transfertitle": "Transfer from PlayerHUD",
        "hudcoinvalue": 15,
        "hudcoinstext": "PlayerHUD: 15",
        "transferamountlabel": "Amount",
        "transferbuttonlabel": "Transfer",
        "progresstext": "Current progress: Level 2, Phase 5",
        "minquestionstext": "This match requires answering at least 3 question(s).",
        "difficultylabel": "Choose your difficulty",
        "difficultyhelpicon": "<a class=\"btn btn-link p-0\" role=\"button\"><i class=\"icon fa fa-question-circle\"></i></a>",
        "difficultychoices": [
            {"value": "easy", "label": "Easy", "checked": false},
            {"value": "normal", "label": "Normal", "checked": true},
            {"value": "hard", "label": "Hard", "checked": false}
        ],
        "difficultycurrent": "",
        "speechenabled": false,
        "speechlabel": "Speak game announcements aloud",
        "demourl": "/mod/playerpuzzle/play.php?id=1&isdemo=1",
        "playdemotext": "Play Demo",
        "canmanagequestions": true,
        "managequestionsurl": "/mod/playerpuzzle/managequestions.php?id=1",
        "managequestionslabel": "Manage questions",
        "shopmenulabel": "Shop",
        "settingsmenulabel": "Settings",
        "backlabel": "Back",
        "musicenabled": true,
        "musiclabel": "Music",
        "sfxenabled": true,
        "sfxlabel": "Sound effects",
        "difficultyselectedtext": "Difficulty: Normal",
        "showranking": true,
        "rankingbuttontext": "Ranking",
        "rankingtitle": "Class ranking",
        "rankingnote": "Points out of 100: a complete campaign is worth 100, counting only verified victories.",
        "rankingposition": "Position",
        "rankingstudent": "Student",
        "rankingpoints": "Points",
        "rankingyou": "(you)",
        "rankingempty": "Nobody has scored yet.",
        "rankingisempty": false,
        "rankingrows": [
            {"position": 1, "fullname": "Ana Souza", "points": "80", "iscurrentuser": false},
            {"position": 2, "fullname": "Bruno Lima", "points": "60", "iscurrentuser": true}
        ],
        "rankinghasoutsider": false,
        "rankingoutsider": null
    }
}}
<div class="pp-lobby" style="border-image-source: url('{{panelstoneurl}}');">
    <span class="pp-lobby-ember" aria-hidden="true"></span>
    <span class="pp-lobby-ember" aria-hidden="true"></span>
    <span class="pp-lobby-ember" aria-hidden="true"></span>
    <span class="pp-lobby-ember" aria-hidden="true"></span>
    <span class="pp-lobby-ember" aria-hidden="true"></span>
    <span class="pp-lobby-ember" aria-hidden="true"></span>

    <div class="pp-lobby-rig">
        <div class="pp-lobby-hero" aria-hidden="true">
            <img src="{{heroimageurl}}" alt="">
        </div>

        <div class="pp-lobby-panel">
            <div id="pp-lobby-main" class="pp-lobby-view">
                <div class="pp-lobby-ribbon" style="background-image: url('{{scrollbannerurl}}');">
                    <h2 class="pp-lobby-ribbon-title">
                        {{#progresstext}}{{progresstext}}{{/progresstext}}
                        {{^progresstext}}{{readytext}}{{/progresstext}}
                    </h2>
                </div>

                {{#isguest}}
                <p class="pp-lobby-note">{{guestdemoonlytext}}</p>
                {{/isguest}}

                {{^isguest}}
                <div class="pp-lobby-stats">
                    <span class="pp-lobby-chip" data-role="coinchip" aria-label="{{coinstext}}">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <circle cx="12" cy="12" r="9" fill="#e0a83e" stroke="#8a611c" stroke-width="1.5"/>
                            <circle cx="12" cy="12" r="5.4" fill="none" stroke="#8a611c" stroke-width="1.2"/>
                        </svg>
                        <span data-role="coinvalue" aria-hidden="true">{{coinvalue}}</span>
                    </span>
                </div>
                {{/isguest}}

                <div class="pp-lobby-menu">
                    {{^isguest}}
                    <button
                        type="button"
                        class="pp-lobby-menu-btn"
                        data-action="open-panel"
                        data-panel="pp-lobby-shop"
                        aria-controls="pp-lobby-shop"
                        aria-expanded="false"
                    >
                        <i class="fa fa-shopping-cart" aria-hidden="true"></i>
                        <span>{{shopmenulabel}}</span>
                    </button>
                    {{/isguest}}
                    {{#showranking}}
                    <button
                        type="button"
                        class="pp-lobby-menu-btn"
                        data-action="open-panel"
                        data-panel="pp-lobby-ranking"
                        aria-controls="pp-lobby-ranking"
                        aria-expanded="false"
                    >
                        <i class="fa fa-trophy" aria-hidden="true"></i>
                        <span>{{rankingbuttontext}}</span>
                    </button>
                    {{/showranking}}
                    <button
                        type="button"
                        class="pp-lobby-menu-btn"
                        data-action="open-panel"
                        data-panel="pp-lobby-settings"
                        aria-controls="pp-lobby-settings"
                        aria-expanded="false"
                    >
                        <i class="fa fa-cog" aria-hidden="true"></i>
                        <span>{{settingsmenulabel}}</span>
                    </button>
                </div>

                {{#difficultyselectedtext}}
                <p class="pp-lobby-note" id="pp-lobby-difficulty-readout">{{difficultyselectedtext}}</p>
                {{/difficultyselectedtext}}
                {{#difficultycurrent}}
                <p class="pp-lobby-note">{{difficultycurrent}}</p>
                {{/difficultycurrent}}

                {{^isguest}}
                <form method="post" action="{{{playurl}}}" id="pp-lobby-playform">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    <button type="submit" class="pp-lobby-play">{{playtext}}</button>
                </form>
                {{/isguest}}

                <form method="post" action="{{{demourl}}}">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    <input type="hidden" name="isdemo" value="1">
                    <button type="submit" class="pp-lobby-playdemo">{{playdemotext}}</button>
                </form>

                {{#minquestionstext}}
                <p class="pp-lobby-note">{{minquestionstext}}</p>
                {{/minquestionstext}}

                {{#canmanagequestions}}
                <a href="{{managequestionsurl}}" class="pp-lobby-managelink">{{managequestionslabel}}</a>
                {{/canmanagequestions}}
            </div>

            {{^isguest}}
            <section id="pp-lobby-shop" class="pp-lobby-view" aria-labelledby="pp-lobby-shop-title" hidden>
                <h3 id="pp-lobby-shop-title" class="pp-lobby-view-title" tabindex="-1">{{shoptitle}}</h3>
                <div class="pp-lobby-stats">
                    <span class="pp-lobby-chip" data-role="coinchip" aria-label="{{coinstext}}">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <circle cx="12" cy="12" r="9" fill="#e0a83e" stroke="#8a611c" stroke-width="1.5"/>
                            <circle cx="12" cy="12" r="5.4" fill="none" stroke="#8a611c" stroke-width="1.2"/>
                        </svg>
                        <span data-role="coinvalue" aria-hidden="true">{{coinvalue}}</span>
                    </span>
                </div>
                <div class="pp-lobby-shop" data-cmid="{{cmid}}">
                    <ul class="pp-lobby-shop-list">
                        {{#shopitems}}
                        <li class="pp-lobby-shop-item" data-type="{{type}}">
                            <span class="pp-lobby-shop-name">{{label}}</span>
                            <span class="pp-lobby-shop-owned" data-role="owned">{{ownedtext}}</span>
                            <button
                                type="button"
                                class="btn btn-sm btn-outline-primary pp-lobby-buy"
                                data-type="{{type}}"
                                aria-label="{{arialabel}}"
                            >
                                {{buylabel}}
                                <span class="pp-lobby-shop-price" aria-hidden="true">🪙{{price}}</span>
                            </button>
                        </li>
                        {{/shopitems}}
                    </ul>
                </div>

                {{#hastransfer}}
                <div class="pp-lobby-transfer" data-cmid="{{cmid}}">
                    <h4 class="pp-lobby-transfer-title">{{transfertitle}}</h4>
                    <span class="pp-lobby-chip" data-role="hudcoinchip" aria-label="{{hudcoinstext}}">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <circle cx="12" cy="12" r="9" fill="#8ea7c9" stroke="#3f5670" stroke-width="1.5"/>
                            <circle cx="12" cy="12" r="5.4" fill="none" stroke="#3f5670" stroke-width="1.2"/>
                        </svg>
                        <span data-role="hudcoinvalue" aria-hidden="true">{{hudcoinvalue}}</span>
                    </span>
                    <label for="pp-lobby-transfer-amount" class="pp-lobby-transfer-label">{{transferamountlabel}}</label>
                    <input
                        type="number"
                        id="pp-lobby-transfer-amount"
                        class="pp-lobby-transfer-input"
                        min="1"
                        step="1"
                        value="1"
                    >
                    <button type="button" class="btn btn-sm btn-outline-secondary pp-lobby-transfer-btn">
                        {{transferbuttonlabel}}
                    </button>
                </div>
                {{/hastransfer}}

                <button type="button" class="pp-lobby-playdemo" data-action="close-panel">{{backlabel}}</button>
            </section>
            {{/isguest}}

            <section id="pp-lobby-settings" class="pp-lobby-view" aria-labelledby="pp-lobby-settings-title" hidden>
                <h3 id="pp-lobby-settings-title" class="pp-lobby-view-title" tabindex="-1">{{settingsmenulabel}}</h3>

                {{#difficultylabel}}
                <fieldset class="pp-lobby-difficulty">
                    <legend class="pp-lobby-difficulty-legend">
                        <span>{{difficultylabel}}</span>
                        {{{difficultyhelpicon}}}
                    </legend>
                    <div class="pp-lobby-difficulty-options">
                        {{#difficultychoices}}
                        <span class="pp-lobby-difficulty-option">
                            <input
                                type="radio"
                                name="difficulty"
                                form="pp-lobby-playform"
                                id="pp-difficulty-{{value}}"
                                value="{{value}}"
                                {{#checked}}checked{{/checked}}
                            >
                            <label for="pp-difficulty-{{value}}">{{label}}</label>
                        </span>
                        {{/difficultychoices}}
                    </div>
                </fieldset>
                {{/difficultylabel}}

                <div class="form-check pp-lobby-toggle">
                    <input
                        type="checkbox"
                        class="form-check-input"
                        id="pp-lobby-speech"
                        {{#speechenabled}}checked{{/speechenabled}}
                    >
                    <label class="form-check-label" for="pp-lobby-speech">{{speechlabel}}</label>
                </div>

                <div class="form-check pp-lobby-toggle">
                    <input
                        type="checkbox"
                        class="form-check-input"
                        id="pp-lobby-music"
                        {{#musicenabled}}checked{{/musicenabled}}
                    >
                    <label class="form-check-label" for="pp-lobby-music">{{musiclabel}}</label>
                </div>

                <div class="form-check pp-lobby-toggle">
                    <input
                        type="checkbox"
                        class="form-check-input"
                        id="pp-lobby-sfx"
                        {{#sfxenabled}}checked{{/sfxenabled}}
                    >
                    <label class="form-check-label" for="pp-lobby-sfx">{{sfxlabel}}</label>
                </div>

                <button type="button" class="pp-lobby-playdemo" data-action="close-panel">{{backlabel}}</button>
            </section>

            {{#showranking}}
            <section id="pp-lobby-ranking" class="pp-lobby-view" aria-labelledby="pp-lobby-ranking-title" hidden>
                <h3 id="pp-lobby-ranking-title" class="pp-lobby-view-title" tabindex="-1">{{rankingtitle}}</h3>
                <p class="pp-lobby-note">{{rankingnote}}</p>
                {{#rankingisempty}}
                <p class="pp-lobby-ranking-empty">{{rankingempty}}</p>
                {{/rankingisempty}}
                {{^rankingisempty}}
                <table class="pp-lobby-ranking-table table-reboot">
                    <caption class="visually-hidden">{{rankingtitle}}</caption>
                    <thead>
                        <tr>
                            <th scope="col">{{rankingposition}}</th>
                            <th scope="col">{{rankingstudent}}</th>
                            <th scope="col">{{rankingpoints}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#rankingrows}}
                        <tr {{#iscurrentuser}}class="pp-lobby-ranking-me" aria-current="true"{{/iscurrentuser}}>
                            <td>{{position}}</td>
                            <td>{{fullname}} {{#iscurrentuser}}<span class="pp-lobby-ranking-youtag">{{rankingyou}}</span>{{/iscurrentuser}}</td>
                            <td>{{points}}</td>
                        </tr>
                        {{/rankingrows}}
                        {{#rankinghasoutsider}}
                        {{#rankingoutsider}}
                        <tr class="pp-lobby-ranking-me pp-lobby-ranking-outsider" aria-current="true">
                            <td>{{position}}</td>
                            <td>{{fullname}} <span class="pp-lobby-ranking-youtag">{{rankingyou}}</span></td>
                            <td>{{points}}</td>
                        </tr>
                        {{/rankingoutsider}}
                        {{/rankinghasoutsider}}
                    </tbody>
                </table>
                {{/rankingisempty}}
                <button type="button" class="pp-lobby-playdemo" data-action="close-panel">{{backlabel}}</button>
            </section>
            {{/showranking}}
        </div>
    </div>
</div>
