{{!
    @template mod_playerpuzzle/view_lobby

    Lobby layout for the PlayerPuzzle activity.

    Example context (json):
    {
        "playurl": "/mod/playerpuzzle/play.php?id=1",
        "playtext": "Play Game",
        "sesskey": "abc123example",
        "readytext": "Ready for adventure?",
        "heroimageurl": "https://example.com/moodle/theme/image.php/boost/mod_playerpuzzle/1/player",
        "herocycle": "[\"https://example.com/moodle/mod/playerpuzzle/pix/heroes/warriorf1.webp\"]",
        "frameurl": "https://example.com/moodle/mod/playerpuzzle/pix/lobby_frame.webp",
        "textureurl": "https://example.com/moodle/mod/playerpuzzle/pix/lobby_texture.webp",
        "scrollbannerurl": "https://example.com/moodle/mod/playerpuzzle/pix/scroll_banner.webp",
        "cmid": 1,
        "coinvalue": 42,
        "coinstext": "PuzzleCoin: 42",
        "shoptitle": "Shop",
        "shopitems": [
            {"type": "potion", "label": "Potion", "quantity": 2, "ownedtext": "Owned: 2", "price": 8, "buylabel": "Buy", "arialabel": "Buy Potion for 8 coins"},
            {"type": "shield", "label": "Shield", "quantity": 0, "ownedtext": "Owned: 0", "price": 10, "buylabel": "Buy", "arialabel": "Buy Shield for 10 coins"}
        ],
        "hastransfer": true,
        "transfertitle": "Transfer from PlayerHUD",
        "hudcoinvalue": 15,
        "hudcoinstext": "PlayerHUD: 15",
        "transferamountlabel": "Amount",
        "transferbuttonlabel": "Transfer",
        "progresstext": "Current progress: Level 2, Phase 5",
        "minquestionstext": "This match requires answering at least 3 question(s).",
        "difficultylabel": "Choose your difficulty",
        "difficultyhelp": "Easy halves the opponent's HP and damage and the coins you earn; Hard doubles the opponent and triples the coins.",
        "difficultyvalue": "normal",
        "difficultychoicesjson": "[{\"value\":\"easy\",\"text\":\"Difficulty: Easy\",\"description\":\"Halved.\"}]",
        "difficultyselectedtext": "Difficulty: Normal",
        "difficultydescription": "The standard fight.",
        "difficultylockedtext": "",
        "difficultylockednote": "",
        "demodifficulty": "normal",
        "difficultyopennote": "",
        "speechenabled": false,
        "speechlabel": "Speak game announcements aloud",
        "demourl": "/mod/playerpuzzle/hero.php?id=1",
        "herourl": "/mod/playerpuzzle/hero.php?id=1",
        "playdemotext": "Play Demo",
        "canmanagequestions": true,
        "managequestionsurl": "/mod/playerpuzzle/managequestions.php?id=1",
        "managequestionslabel": "Manage questions",
        "shopmenulabel": "Shop",
        "settingsmenulabel": "Settings",
        "backlabel": "Back",
        "musicenabled": true,
        "musiclabel": "Music",
        "sfxenabled": true,
        "sfxlabel": "Sound effects",
        "canviewhistory": true,
        "historytitle": "Campaign history",
        "historyempty": "Your Campaigns will appear here once you start one.",
        "historyopenlabel": "See your Campaign history",
        "historyhasrows": true,
        "historyrows": [
            {
                "title": "Campaign 2",
                "statustext": "In progress",
                "statusclass": "pp-history-current",
                "pointstext": "30,0 points",
                "phasestext": "3 of 10 phases",
                "attemptstext": "1 of 5 attempts",
                "datestext": "05/11/26",
                "herohas": true,
                "heroname": "Female mage",
                "heroimageurl": "https://example.com/moodle/mod/playerpuzzle/pix/heroes/magef1.webp",
                "herostagetext": "Stage 1 of 4"
            }
        ],
        "showranking": true,
        "rankingbuttontext": "Ranking",
        "rankingtitle": "Class ranking",
        "rankingnote": "Points out of 100: a complete campaign is worth 100, counting only verified victories.",
        "rankingposition": "Position",
        "rankingstudent": "Student",
        "rankingpoints": "Points",
        "rankingyou": "(you)",
        "rankingempty": "Nobody has scored yet.",
        "rankingisempty": false,
        "rankingrows": [
            {"position": 1, "fullname": "Ana Souza", "points": "80", "iscurrentuser": false},
            {"position": 2, "fullname": "Bruno Lima", "points": "60", "iscurrentuser": true}
        ],
        "rankinghasoutsider": false,
        "rankingoutsider": null
    }
}}
<div
    class="pp-lobby"
    style="--pp-frame: url('{{frameurl}}'); --pp-texture: url('{{textureurl}}'); --pp-ribbon: url('{{scrollbannerurl}}');"
>
    <span class="pp-lobby-ember" aria-hidden="true"></span>
    <span class="pp-lobby-ember" aria-hidden="true"></span>
    <span class="pp-lobby-ember" aria-hidden="true"></span>
    <span class="pp-lobby-ember" aria-hidden="true"></span>
    <span class="pp-lobby-ember" aria-hidden="true"></span>
    <span class="pp-lobby-ember" aria-hidden="true"></span>

    <div class="pp-lobby-rig">
        <div class="pp-lobby-hero" aria-hidden="true" {{#herocycle}}data-heroes="{{herocycle}}"{{/herocycle}}>
            <img src="{{heroimageurl}}" alt="">
        </div>

        <div class="pp-lobby-panel">
            <div id="pp-lobby-main" class="pp-lobby-view pp-lobby-main">
                <div class="pp-lobby-ribbon">
                    <h2 class="pp-lobby-ribbon-title">
                        {{#progresstext}}{{progresstext}}{{/progresstext}}
                        {{^progresstext}}{{readytext}}{{/progresstext}}
                    </h2>
                </div>

                <div class="pp-lobby-status">
                    {{#campaignnametext}}
                    {{#canviewhistory}}
                    <button
                        type="button"
                        class="pp-lobby-chip pp-lobby-chip-button"
                        data-action="open-panel"
                        data-panel="pp-lobby-history"
                        aria-controls="pp-lobby-history"
                        aria-expanded="false"
                        title="{{historyopenlabel}}"
                    >
                        <i class="fa fa-flag" aria-hidden="true"></i>
                        <span>{{campaignnametext}}</span>
                        <i class="fa fa-angle-right" aria-hidden="true"></i>
                    </button>
                    {{/canviewhistory}}
                    {{^canviewhistory}}
                    <span class="pp-lobby-chip">
                        <i class="fa fa-flag" aria-hidden="true"></i>
                        <span>{{campaignnametext}}</span>
                    </span>
                    {{/canviewhistory}}
                    {{/campaignnametext}}
                    {{^campaignnametext}}
                    {{#canviewhistory}}
                    {{#historyhasrows}}
                    <button
                        type="button"
                        class="pp-lobby-chip pp-lobby-chip-button"
                        data-action="open-panel"
                        data-panel="pp-lobby-history"
                        aria-controls="pp-lobby-history"
                        aria-expanded="false"
                        title="{{historyopenlabel}}"
                    >
                        <i class="fa fa-flag" aria-hidden="true"></i>
                        <span>{{historytitle}}</span>
                        <i class="fa fa-angle-right" aria-hidden="true"></i>
                    </button>
                    {{/historyhasrows}}
                    {{/canviewhistory}}
                    {{/campaignnametext}}
                    {{#difficultychoicesjson}}
                    <button
                        type="button"
                        class="pp-lobby-chip pp-lobby-chip-button"
                        data-action="cycle-difficulty"
                        data-choices="{{difficultychoicesjson}}"
                        title="{{difficultylabel}}"
                        aria-describedby="pp-lobby-difficulty-description"
                    >
                        <i class="fa fa-bolt" aria-hidden="true"></i>
                        <span id="pp-lobby-difficulty-readout">{{difficultyselectedtext}}</span>
                        <i class="fa fa-angle-right" aria-hidden="true"></i>
                    </button>
                    <input
                        type="hidden"
                        name="difficulty"
                        form="pp-lobby-playform"
                        id="pp-lobby-difficulty-value"
                        value="{{difficultyvalue}}"
                    >
                    <input type="hidden" name="difficultychoice" value="1" form="pp-lobby-playform">
                    {{/difficultychoicesjson}}
                    {{#difficultylockedtext}}
                    <span class="pp-lobby-chip">
                        <i class="fa fa-lock" aria-hidden="true"></i>
                        <span>{{difficultylockedtext}}</span>
                    </span>
                    {{/difficultylockedtext}}
                </div>
                {{#difficultydescription}}
                <p class="pp-lobby-desc" id="pp-lobby-difficulty-description" aria-live="polite">{{difficultydescription}}</p>
                {{/difficultydescription}}

                {{#guestdemoonlytext}}
                <p class="pp-lobby-note">{{guestdemoonlytext}}</p>
                {{/guestdemoonlytext}}
                {{#difficultylockednote}}
                <p class="pp-lobby-note">{{difficultylockednote}}</p>
                {{/difficultylockednote}}
                {{#difficultyopennote}}
                <p class="pp-lobby-note">{{difficultyopennote}}</p>
                {{/difficultyopennote}}

                {{#noquestions}}
                <p class="pp-lobby-note" role="status">
                    {{noquestionstext}}
                    {{#canmanagequestions}}
                    <a href="{{managequestionsurl}}" class="pp-lobby-managelink">{{managequestionslabel}}</a>
                    {{/canmanagequestions}}
                </p>
                {{/noquestions}}
                {{^noquestions}}
                {{^isguest}}
                {{#newcampaigntext}}
                <p class="pp-lobby-note" role="status">{{newcampaigntext}}</p>
                {{/newcampaigntext}}
                {{#campaignlimittext}}
                <p class="pp-lobby-note" role="status">{{campaignlimittext}}</p>
                {{/campaignlimittext}}
                {{^campaignlimittext}}
                <form
                    method="post"
                    action="{{#playviahero}}{{herourl}}{{/playviahero}}{{^playviahero}}{{playurl}}{{/playviahero}}"
                    id="pp-lobby-playform"
                    {{#newcampaign}}data-confirm="{{newcampaignconfirmtext}}"{{/newcampaign}}
                >
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    {{#playmode}}
                    <input type="hidden" name="mode" value="{{playmode}}">
                    {{/playmode}}
                    {{#newcampaign}}
                    <input type="hidden" name="confirmnewcampaign" value="1">
                    {{/newcampaign}}
                    <button type="submit" class="pp-lobby-play">{{playtext}}</button>
                </form>
                {{/campaignlimittext}}
                {{/isguest}}
                {{/noquestions}}

                {{#minquestionstext}}
                <p class="pp-lobby-hint">{{minquestionstext}}</p>
                {{/minquestionstext}}

                <div class="pp-lobby-menu">
                    <button
                        type="button"
                        class="pp-lobby-menu-btn"
                        data-action="open-panel"
                        data-panel="pp-lobby-settings"
                        aria-controls="pp-lobby-settings"
                        aria-expanded="false"
                    >
                        <i class="fa fa-cog" aria-hidden="true"></i>
                        <span>{{settingsmenulabel}}</span>
                    </button>
                    {{#showranking}}
                    <button
                        type="button"
                        class="pp-lobby-menu-btn"
                        data-action="open-panel"
                        data-panel="pp-lobby-ranking"
                        aria-controls="pp-lobby-ranking"
                        aria-expanded="false"
                    >
                        <i class="fa fa-trophy" aria-hidden="true"></i>
                        <span>{{rankingbuttontext}}</span>
                    </button>
                    {{/showranking}}
                    {{^noquestions}}
                    <form method="post" action="{{demourl}}" class="pp-lobby-menu-form">
                        <input type="hidden" name="sesskey" value="{{sesskey}}">
                        <input type="hidden" name="mode" value="demo">
                        <input type="hidden" name="difficulty" id="pp-lobby-demo-difficulty" value="{{demodifficulty}}">
                        <input type="hidden" name="difficultychoice" value="1">
                        <button type="submit" class="pp-lobby-menu-btn">
                            <i class="fa fa-graduation-cap" aria-hidden="true"></i>
                            <span>{{playdemotext}}</span>
                        </button>
                    </form>
                    {{/noquestions}}
                    {{#howto}}
                    <button
                        type="button"
                        class="pp-lobby-menu-btn"
                        data-action="open-panel"
                        data-panel="pp-lobby-howto"
                        aria-controls="pp-lobby-howto"
                        aria-expanded="false"
                    >
                        <i class="fa fa-circle-question" aria-hidden="true"></i>
                        <span>{{title}}</span>
                    </button>
                    {{/howto}}
                    {{^isguest}}
                    {{^campaignended}}
                    <button
                        type="button"
                        class="pp-lobby-menu-btn"
                        data-action="open-panel"
                        data-panel="pp-lobby-shop"
                        aria-controls="pp-lobby-shop"
                        aria-expanded="false"
                    >
                        <i class="fa fa-shopping-cart" aria-hidden="true"></i>
                        <span>{{shopmenulabel}}</span>
                        <span class="pp-lobby-coins" data-role="coinchip" aria-label="{{coinstext}}">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <circle cx="12" cy="12" r="9" fill="#e0a83e" stroke="#8a611c" stroke-width="1.5"/>
                                <circle cx="12" cy="12" r="5.4" fill="none" stroke="#8a611c" stroke-width="1.2"/>
                            </svg>
                            <span data-role="coinvalue" aria-hidden="true">{{coinvalue}}</span>
                        </span>
                    </button>
                    {{/campaignended}}
                    {{/isguest}}
                </div>
            </div>

            {{^isguest}}
            {{^campaignended}}
            <section id="pp-lobby-shop" class="pp-lobby-view" aria-labelledby="pp-lobby-shop-title" data-wide="true" hidden>
                <h3 id="pp-lobby-shop-title" class="pp-lobby-view-title" tabindex="-1">{{shoptitle}}</h3>
                {{> mod_playerpuzzle/shop_panel }}

                {{#hastransfer}}
                <div class="pp-lobby-transfer" data-cmid="{{cmid}}">
                    <h4 class="pp-lobby-transfer-title">{{transfertitle}}</h4>
                    <span class="pp-lobby-chip" data-role="hudcoinchip" aria-label="{{hudcoinstext}}">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <circle cx="12" cy="12" r="9" fill="#8ea7c9" stroke="#3f5670" stroke-width="1.5"/>
                            <circle cx="12" cy="12" r="5.4" fill="none" stroke="#3f5670" stroke-width="1.2"/>
                        </svg>
                        <span data-role="hudcoinvalue" aria-hidden="true">{{hudcoinvalue}}</span>
                    </span>
                    <label for="pp-lobby-transfer-amount" class="pp-lobby-transfer-label">{{transferamountlabel}}</label>
                    <input
                        type="number"
                        id="pp-lobby-transfer-amount"
                        class="pp-lobby-transfer-input"
                        min="1"
                        step="1"
                        value="1"
                    >
                    <button type="button" class="pp-lobby-menu-btn pp-lobby-transfer-btn">
                        {{transferbuttonlabel}}
                    </button>
                </div>
                {{/hastransfer}}

                <button type="button" class="pp-lobby-menu-btn pp-lobby-back" data-action="close-panel">{{backlabel}}</button>
            </section>
            {{/campaignended}}
            {{/isguest}}

            {{#howto}}
            <section id="pp-lobby-howto" class="pp-lobby-view" aria-labelledby="pp-lobby-howto-title" data-wide="true" hidden>
                <h3 id="pp-lobby-howto-title" class="pp-lobby-view-title" tabindex="-1">{{title}}</h3>
                {{> mod_playerpuzzle/howtoplay_body }}
                <button type="button" class="pp-lobby-menu-btn pp-lobby-back" data-action="close-panel">{{backlabel}}</button>
            </section>
            {{/howto}}

            <section id="pp-lobby-settings" class="pp-lobby-view" aria-labelledby="pp-lobby-settings-title" hidden>
                <h3 id="pp-lobby-settings-title" class="pp-lobby-view-title" tabindex="-1">{{settingsmenulabel}}</h3>

                <div class="form-check pp-lobby-toggle">
                    <input
                        type="checkbox"
                        class="form-check-input"
                        id="pp-lobby-speech"
                        {{#speechenabled}}checked{{/speechenabled}}
                    >
                    <label class="form-check-label" for="pp-lobby-speech">{{speechlabel}}</label>
                </div>

                <div class="form-check pp-lobby-toggle">
                    <input
                        type="checkbox"
                        class="form-check-input"
                        id="pp-lobby-music"
                        {{#musicenabled}}checked{{/musicenabled}}
                    >
                    <label class="form-check-label" for="pp-lobby-music">{{musiclabel}}</label>
                </div>

                <div class="form-check pp-lobby-toggle">
                    <input
                        type="checkbox"
                        class="form-check-input"
                        id="pp-lobby-sfx"
                        {{#sfxenabled}}checked{{/sfxenabled}}
                    >
                    <label class="form-check-label" for="pp-lobby-sfx">{{sfxlabel}}</label>
                </div>

                <button type="button" class="pp-lobby-menu-btn pp-lobby-back" data-action="close-panel">{{backlabel}}</button>
            </section>

            {{#canviewhistory}}
            <section id="pp-lobby-history" class="pp-lobby-view" aria-labelledby="pp-lobby-history-title" data-wide="true" hidden>
                <h3 id="pp-lobby-history-title" class="pp-lobby-view-title" tabindex="-1">{{historytitle}}</h3>
                {{^historyhasrows}}
                <p class="pp-lobby-note">{{historyempty}}</p>
                {{/historyhasrows}}
                {{#historyhasrows}}
                <ol class="pp-history-list">
                    {{#historyrows}}
                    <li class="pp-history-item {{statusclass}}">
                        {{#herohas}}
                        <img class="pp-history-hero" src="{{heroimageurl}}" alt="" width="64" height="64">
                        {{/herohas}}
                        <div class="pp-history-body">
                            <p class="pp-history-name">
                                <strong>{{title}}</strong>
                                <span class="pp-history-status">{{statustext}}</span>
                            </p>
                            {{#herohas}}
                            <p class="pp-history-meta">{{heroname}} · {{herostagetext}}</p>
                            {{/herohas}}
                            <p class="pp-history-meta">{{phasestext}} · {{attemptstext}}</p>
                            <p class="pp-history-date">{{datestext}}</p>
                        </div>
                        <p class="pp-history-points">{{pointstext}}</p>
                    </li>
                    {{/historyrows}}
                </ol>
                {{/historyhasrows}}
                <button type="button" class="pp-lobby-menu-btn pp-lobby-back" data-action="close-panel">{{backlabel}}</button>
            </section>
            {{/canviewhistory}}

            {{#showranking}}
            <section id="pp-lobby-ranking" class="pp-lobby-view" aria-labelledby="pp-lobby-ranking-title" hidden>
                <h3 id="pp-lobby-ranking-title" class="pp-lobby-view-title" tabindex="-1">{{rankingtitle}}</h3>
                <p class="pp-lobby-note">{{rankingnote}}</p>
                {{#rankingisempty}}
                <p class="pp-lobby-ranking-empty">{{rankingempty}}</p>
                {{/rankingisempty}}
                {{^rankingisempty}}
                <table class="pp-lobby-ranking-table table-reboot">
                    <caption class="visually-hidden">{{rankingtitle}}</caption>
                    <thead>
                        <tr>
                            <th scope="col">{{rankingposition}}</th>
                            <th scope="col">{{rankingstudent}}</th>
                            <th scope="col">{{rankingpoints}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#rankingrows}}
                        <tr {{#iscurrentuser}}class="pp-lobby-ranking-me" aria-current="true"{{/iscurrentuser}}>
                            <td>{{position}}</td>
                            <td>{{fullname}} {{#iscurrentuser}}<span class="pp-lobby-ranking-youtag">{{rankingyou}}</span>{{/iscurrentuser}}</td>
                            <td>{{points}}</td>
                        </tr>
                        {{/rankingrows}}
                        {{#rankinghasoutsider}}
                        {{#rankingoutsider}}
                        <tr class="pp-lobby-ranking-me pp-lobby-ranking-outsider" aria-current="true">
                            <td>{{position}}</td>
                            <td>{{fullname}} <span class="pp-lobby-ranking-youtag">{{rankingyou}}</span></td>
                            <td>{{points}}</td>
                        </tr>
                        {{/rankingoutsider}}
                        {{/rankinghasoutsider}}
                    </tbody>
                </table>
                {{/rankingisempty}}
                <button type="button" class="pp-lobby-menu-btn pp-lobby-back" data-action="close-panel">{{backlabel}}</button>
            </section>
            {{/showranking}}
        </div>
    </div>
</div>
