{{!
    @template mod_playerpuzzle/view_lobby

    Lobby layout for the PlayerPuzzle activity.

    Example context (json):
    {
        "playurl": "/mod/playerpuzzle/play.php?id=1",
        "playtext": "Play Game",
        "sesskey": "abc123example",
        "hasstats": true,
        "coinstext": "Coins: 42",
        "swordtext": "Sword: 3",
        "shieldtext": "Shield: 1",
        "potiontext": "Potion: 2",
        "progresstext": "Current progress: Level 2, Phase 5",
        "minquestionstext": "This match requires answering at least 3 question(s).",
        "difficultylabel": "Choose your difficulty",
        "difficultyhelpicon": "<a class=\"btn btn-link p-0\" role=\"button\"><i class=\"icon fa fa-question-circle\"></i></a>",
        "difficultychoices": [
            {"value": "easy", "label": "Easy", "checked": false},
            {"value": "normal", "label": "Normal", "checked": true},
            {"value": "hard", "label": "Hard", "checked": false}
        ],
        "difficultycurrent": ""
    }
}}
<div class="pp-lobby text-center mb-5">
    {{#hasstats}}
    <div class="pp-lobby-stats d-flex flex-wrap justify-content-center mb-3">
        {{#coinstext}}<span class="badge bg-warning text-dark">{{coinstext}}</span>{{/coinstext}}
        {{#swordtext}}<span class="badge bg-primary">{{swordtext}}</span>{{/swordtext}}
        {{#shieldtext}}<span class="badge bg-info text-dark">{{shieldtext}}</span>{{/shieldtext}}
        {{#potiontext}}<span class="badge bg-success">{{potiontext}}</span>{{/potiontext}}
    </div>
    {{/hasstats}}

    {{#progresstext}}
    <p class="pp-lobby-progress">{{progresstext}}</p>
    {{/progresstext}}

    {{#minquestionstext}}
    <p class="alert alert-info py-2 mb-3 pp-lobby-minquestions">{{minquestionstext}}</p>
    {{/minquestionstext}}

    <form method="post" action="{{{playurl}}}" class="mt-3">
        <input type="hidden" name="sesskey" value="{{sesskey}}">

        {{#difficultycurrent}}
        <p class="pp-lobby-difficulty-current text-muted mb-3">{{difficultycurrent}}</p>
        {{/difficultycurrent}}

        {{#difficultylabel}}
        <div class="pp-lobby-difficulty mb-3 mx-auto text-start">
            <label class="fw-bold" for="pp-difficulty">{{difficultylabel}}</label>
            {{{difficultyhelpicon}}}
            <select class="form-select" name="difficulty" id="pp-difficulty">
                {{#difficultychoices}}
                <option value="{{value}}" {{#checked}}selected{{/checked}}>{{label}}</option>
                {{/difficultychoices}}
            </select>
        </div>
        {{/difficultylabel}}

        <button type="submit" class="btn btn-primary btn-lg px-5 py-3 fs-4 fw-bold shadow-sm">
            {{playtext}}
        </button>
    </form>
</div>
